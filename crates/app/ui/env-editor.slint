import { Button, ComboBox, Palette, VerticalBox } from "std-widgets.slint";
import { CodeEdit } from "code-edit.slint";
import { Family } from "family.slint";

// An in-window dialog (like About) to edit the environments of the selected project, each one a JSON object.
export component EnvEditor inherits Rectangle {
    in property <[string]> names;
    in-out property <int> index;
    in-out property <string> text;
    in property <string> error; // already translated; "" when the JSON is fine
    // The text was changed and not saved yet. Rust clears it when it loads or saves; switching or editing the list
    // of environments is blocked meanwhile. Close, Escape and clicking outside discard the draft.
    in-out property <bool> dirty;
    callback picked(int);
    callback edited(string);
    callback save(string);
    callback add();
    callback rename();
    callback delete();
    callback dismiss();
    background: Family.scrim;
    init => { keys.focus(); }

    // `capture-key-pressed` so Escape works while the text editor has the focus.
    keys := FocusScope {
        // Keep the backdrop inside the focus scope so focused inputs cannot intercept outside clicks.
        TouchArea { clicked => { root.dismiss(); } }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: min(parent.width - 32px, 640px);
            height: min(parent.height - 32px, 480px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            TouchArea { }
            VerticalBox {
                spacing: 8px;
                Text { text: @tr("Environments"); font-size: Family.page-title; font-weight: Family.page-weight; }
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: @tr("Each environment is a JSON object. Use its keys in URLs, headers, params and bodies, like");
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    Text { text: "{{host}}"; font-weight: Family.section-weight; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.names;
                        enabled: root.names.length > 0 && !root.dirty;
                        current-index <=> root.index;
                        selected(v) => { root.picked(self.current-index); }
                    }
                    Button { text: @tr("Add"); enabled: !root.dirty; clicked => { root.add(); } }
                    Button { text: @tr("Rename"); enabled: root.names.length > 0 && !root.dirty; clicked => { root.rename(); } }
                    Button { text: @tr("Delete"); enabled: root.names.length > 0 && !root.dirty; clicked => { root.delete(); } }
                }
                if root.names.length == 0: Text {
                    text: @tr("No environments yet. Add one to define variables such as the host or a token.");
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                if root.names.length > 0: CodeEdit {
                    body-kind: 3;
                    highlight-slot: 2;
                    text <=> root.text;
                    edited(t) => { root.dirty = true; root.edited(t); }
                }
                if root.error != "": Text { text: root.error; color: Family.danger; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    if root.dirty: Text {
                        text: @tr("Unsaved changes");
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if !root.dirty: Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Close"); clicked => { root.dismiss(); } }
                    Button {
                        text: @tr("Save");
                        primary: true;
                        enabled: root.dirty && root.error == "";
                        clicked => { root.save(root.text); }
                    }
                }
            }
        }
    }
}
